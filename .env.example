# Habit X API — local/dev defaults (no secrets)
HABITX_HOST=127.0.0.1
HABITX_PORT=4600
NODE_ENV=development
# DATABASE_URL=postgres://habitx_app@127.0.0.1:5432/habitx
# HABITX_DEV_TOKEN=dev-only-change-me
# Production consumer store (VPS only — never ship service role in iOS)
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role (sb_secret_... or JWT role=service_role) — required to persist Q
SUPABASE_SECRET_KEY=
# publishable/anon — used with the user's JWT under RLS
SUPABASE_PUBLISHABLE_KEY=
